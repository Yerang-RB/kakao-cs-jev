# 비밀값은 저장소가 아니라 `<홈>/.claude/` 아래 네 파일에 둔다(코드가 os.homedir() 기준으로 KEY=값 줄을 읽는다).
# 권한은 600. 아래는 파일별 키 목록이다 — 값은 예시.

# ~/.claude/typesafe.env — Jev(TypeSafe System One) 키. 봇 분류·web 분류 미리보기
JEV_API_KEY=ts-...

# ~/.claude/notify.env — 사람 큐 알림을 받을 Discord 웹훅
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ~/.claude/kakao.env — 봇 전용 카카오 계정(scripts/login.ts 첫 로그인용)
KAKAO_ID=bot@example.com
KAKAO_PW=...

# ~/.claude/kakao-cs.env — compose가 셸 환경으로 읽는다: set -a; . ~/.claude/kakao-cs.env; set +a
POSTGRES_PASSWORD=...
SESSION_SECRET=32자-이상-난수
WEB_DB_PASSWORD=...          # web 전용 DB 롤 cs_web
ROOMS=1000000000000001       # 봇이 열어도 되는 방 ID(쉼표 구분) — 목록 밖 방은 열지 않는다
# DATABASE_URL=postgres://... # 환경변수가 없을 때 봇·스크립트가 읽는 폴백
